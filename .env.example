# The desktop AI Settings window is the primary configuration method.
# These values are used as first-run defaults when settings.json does not exist.

# Cloud / OpenAI-compatible provider
CLOUD_API_ENDPOINT=https://integrate.api.nvidia.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=

# LM Studio / OpenAI-compatible local server
# Start the server in LM Studio. Default endpoint: http://localhost:1234/v1
LM_STUDIO_ENDPOINT=http://localhost:1234/v1
LM_STUDIO_API_KEY=
LM_STUDIO_MODEL=

# Generation defaults
MODEL_MAX_TOKENS=1200
TEMPERATURE=0.0
TOP_P=0.9
MAX_AGENT_STEPS=14
MAX_PROTOCOL_REPAIRS=2
